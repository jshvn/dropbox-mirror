MIRROR_DROPBOX_APP_SECRET=op://n2njbgnjzkufe7ft6eq2g6bvay/dropbox/app_secret
MIRROR_DROPBOX_REFRESH_TOKEN=op://n2njbgnjzkufe7ft6eq2g6bvay/dropbox/refresh_token
MIRROR_DROPBOX_ACCOUNT_ID=op://n2njbgnjzkufe7ft6eq2g6bvay/dropbox/account_id
MIRROR_PROTON_DESTINATION=op://n2njbgnjzkufe7ft6eq2g6bvay/proton/destination
